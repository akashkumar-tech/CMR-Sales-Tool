# Copy to backend/.env and fill in real values. Never commit backend/.env.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="beet_local"
CORS_ORIGINS="*"
# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="change-me"
ADMIN_EMAIL="admin@beet.health"
ADMIN_NAME="Beet Admin"
# Emergent managed email key. Leave empty locally: no email is sent and (dev mode only) the code is shown on screen.
EMERGENT_EMAIL_KEY=""
EMAIL_FROM_NAME="Beet.Health CRM"
# "true" only for local/preview. Production must be "false".
OTP_DEV_MODE="true"
# Only emails at this domain can be added as staff (leave empty to allow any domain).
APPROVED_EMAIL_DOMAIN="beet.health"
APP_URL="http://localhost:3000"
# Team time zone: defines "today" for follow-ups/tasks, report periods and the 08:00 reminder email.
APP_TIMEZONE="Asia/Kolkata"
