# Copy to backend/.env and fill in real values. Never commit backend/.env.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="beet_local"
CORS_ORIGINS="*"
# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="change-me"
ADMIN_EMAIL="shivanshi@beet.health"
ADMIN_NAME="Shivanshi"
# Emergent managed email key. Required (or Gmail below) for login: codes are only ever delivered by email.
EMERGENT_EMAIL_KEY=""
EMAIL_FROM_NAME="Beet.Health CRM"
# Optional: send through Google Workspace Gmail instead (takes priority over the Emergent key when both are set).
# Reminders/assignments then come from the manager's own mailbox (From, mailed-by and signed-by = beet.health).
# Needs a service account with domain-wide delegation for scope https://www.googleapis.com/auth/gmail.send.
GMAIL_SERVICE_ACCOUNT_FILE=""   # path to the service account JSON key, e.g. "gmail-sender.json"
GMAIL_DEFAULT_SENDER=""         # mailbox for system emails (login codes, daily digest), e.g. "crm@beet.health"
# Only emails at this domain can be added as staff (leave empty to allow any domain).
APPROVED_EMAIL_DOMAIN="beet.health"
APP_URL="http://localhost:3000"
# Team time zone: defines "today" for follow-ups/tasks, report periods and the 08:00 reminder email.
APP_TIMEZONE="Asia/Kolkata"
